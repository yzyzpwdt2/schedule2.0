const SHEET_NAME='北市勤務排程';
function doGet(e){try{return json_(list_())}catch(err){return json_({ok:false,error:String(err)})}}
function doPost(e){try{const b=JSON.parse(e.postData.contents||'{}');if(b.action==='add')return json_(add_(b));return json_({ok:false,error:'Unknown action'})}catch(err){return json_({ok:false,error:String(err)})}}
function list_(){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw Error('找不到工作表：'+SHEET_NAME);const last=sh.getLastRow();if(last<2)return{ok:true,data:[]};const v=sh.getRange(2,1,last-1,7).getDisplayValues(),data=[];v.forEach((r,i)=>{const row=i+2;if(sh.isRowHiddenByUser(row))return;const date=(r[1]||'').trim(),time=(r[2]||'').trim(),customer=(r[3]||'').trim(),task=(r[4]||'').trim(),pt=(r[5]||'').trim(),note=(r[6]||'').trim();if(!date&&!time&&!customer&&!task&&!pt&&!note)return;data.push({row,date,time,customer,task,people:pt?pt.split(/[\/、,，\s]+/).filter(Boolean):[],note})});return{ok:true,data}}
function add_(b){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw Error('找不到工作表：'+SHEET_NAME);const row=Math.max(sh.getLastRow()+1,2),people=Array.isArray(b.people)?b.people.join('/'):String(b.people||'');sh.getRange(row,1,1,7).setValues([[false,b.date||'',b.time||'',b.customer||'',b.task||'',people,b.note||'']]);if(row>2)sh.getRange(row-1,1,1,7).copyTo(sh.getRange(row,1,1,7),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);return{ok:true,row}}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
